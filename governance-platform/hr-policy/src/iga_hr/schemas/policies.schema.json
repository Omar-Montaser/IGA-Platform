{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iga-hr:schema:policies:1.0.0",
  "title": "Module 1 generic access policy catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "snapshot_at",
    "synthetic",
    "effective_from",
    "unlisted_access",
    "entitlements",
    "role_policies",
    "status_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "$ref": "#/$defs/slug"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "synthetic": {
      "type": "boolean"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "unlisted_access": {
      "const": "review"
    },
    "entitlements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entitlement"
      }
    },
    "role_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rolePolicy"
      }
    },
    "status_rules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/statusRule"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    },
    "trimmedString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    },
    "entitlementId": {
      "type": "string",
      "pattern": "^ent:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*(?![\\s\\S])"
    },
    "entitlementIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entitlementId"
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "type",
        "sensitivity",
        "privileged"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entitlementId"
        },
        "name": {
          "$ref": "#/$defs/trimmedString"
        },
        "description": {
          "$ref": "#/$defs/trimmedString"
        },
        "type": {
          "const": "permission"
        },
        "sensitivity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "privileged": {
          "type": "boolean"
        }
      }
    },
    "rolePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "department",
        "role",
        "expected",
        "restricted",
        "privileged"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pol:[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        },
        "department": {
          "$ref": "#/$defs/slug"
        },
        "role": {
          "$ref": "#/$defs/slug"
        },
        "expected": {
          "$ref": "#/$defs/entitlementIds"
        },
        "restricted": {
          "$ref": "#/$defs/entitlementIds"
        },
        "privileged": {
          "$ref": "#/$defs/entitlementIds"
        }
      }
    },
    "statusRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "access"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "on_leave",
            "pre_hire",
            "terminated"
          ]
        },
        "access": {
          "enum": [
            "role_policy",
            "none"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "access": {
                "const": "role_policy"
              }
            }
          },
          "else": {
            "properties": {
              "access": {
                "const": "none"
              }
            }
          }
        }
      ]
    }
  }
}
